#
# Packages for an OpenMasjid node. Kept deliberately short: every megabyte here is RAM and
# SD-card life on a 512 MB board, and every daemon is something that can wedge a screen.

# The kiosk: WPE WebKit on DRM/KMS. NOT Chromium — it does not fit in 512 MB beside
# anything else.
cog
libwpewebkit-1.1-0

# Hardware H.264 decode straight to the display, no X server.
gstreamer1.0-tools
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-libav

# The agent runs on Node.
nodejs

# Wi-Fi provisioning + mDNS so the panel can discover nodes (_omd-node._tcp).
network-manager
avahi-daemon
avahi-utils

# The Pi has no RTC; prayer times need a correct clock.
chrony

# Read-only root with a writable overlay (see 01-run.sh).
overlayroot

# zram swap: 512 MB with a browser in it. Compressed swap in RAM beats writing to the card.
zram-tools

# Hardware watchdog daemon.
watchdog
