node_modules/
dist/
# tsc's incremental cache. Regenerated by `npm run build` in web/, so it reappears as an
# untracked file after every build and would otherwise dirty the tree at every session start.
*.tsbuildinfo
*.log
.DS_Store
.env
data/
server/public/
# Built by `npm run build:agent` and served to Raspberry Pi screens at /pi/agent.js.
# Generated from server/src/pi/, so the source is in the tree and the bundle is not.
server/assets/pi/agent.js

# Throwaway patch scripts used to apply edits. They are deleted on success, so any that
# survive are ones whose run failed part-way — and those are exactly the ones that get
# committed by accident. Three have.
.*.mjs
