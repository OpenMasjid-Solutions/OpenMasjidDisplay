{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    // The repo root, because the server compiles packages/render-core (the shared
    // display engine) as part of its own program — no npm indirection, no symlink,
    // one tsc invocation. Consequence: the emitted tree is dist/server/src/… plus
    // dist/packages/…, so the entry point is dist/server/src/index.js — see the
    // `start` script and the Dockerfile CMD.
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../packages/render-core/src/**/*.ts", "../packages/protocol/src/**/*.ts"],
  // `**/*.test.ts` is anchored at this directory, so the shared package needs its own
  // pattern — without it the render-core tests land in the production build.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "../packages/**/*.test.ts"]
}
