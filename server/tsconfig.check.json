//
// Typechecks the TESTS too, which tsconfig.json deliberately does not (that one is the
// BUILD config, and a test file must never land in dist/).
//
// Worth its own file because that gap has now bitten twice: a required option added to an
// interface left every test constructing it without one, and a dynamic `import('node:events')`
// shape error sat unnoticed — tsx does not typecheck, and the build skipped the files.
// `npm test` runs this first.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": ["src/**/*.ts", "../packages/render-core/src/**/*.ts", "../packages/protocol/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
