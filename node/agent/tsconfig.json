{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    // Spans the repo so packages/protocol compiles into this program — the agent and the
    // controller MUST share one definition of the wire format, and an npm dependency
    // between them would be a lie (they are never published). Consequence: the emitted
    // tree is dist/node/agent/src/… so the entry point is one level deeper; see `start`
    // and image/overlay/etc/systemd/system/omd-agent.service.
    "rootDir": "../..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../packages/protocol/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "../../packages/**/*.test.ts"]
}
