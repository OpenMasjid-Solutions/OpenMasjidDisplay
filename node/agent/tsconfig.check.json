//
// Typechecks the tests too, which tsconfig.json deliberately does not (it is the BUILD
// config, and test files must not land in dist/).
//
// This exists because that gap bit us: adding a required option to AgentOpts left every
// test constructing an Agent without it, and nothing complained — the build skipped the
// test files and tsx does not typecheck. `npm test` runs this first so a test can never
// again drift out of sync with the code it is testing.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts", "../../packages/protocol/src/**/*.ts", "../../server/src/**/*.ts", "../../packages/render-core/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
