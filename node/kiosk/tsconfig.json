{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  // packages/render-core is compiled as part of this app — the SAME source the controller
  // uses, which is what makes the two renderers agree by construction rather than by
  // review. It is platform-free, so it compiles here against DOM libs unchanged.
  "include": ["src/**/*.ts", "../../packages/render-core/src/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "../../packages/**/*.test.ts"]
}
